# Keep false until account setup, expiry, privacy/retention rules, and end-to-end tests are complete.
MEMBERSHIP_ENABLED=false
SITE_URL=https://bssucalgary.app
MEMBERSHIP_EXPIRES_AT=2027-09-01T06:00:00Z
STUDENT_EMAIL_DOMAINS=
# Use Stripe test mode first. Never put these in NEXT_PUBLIC variables.
# Publishable key is safe for Stripe.js. Returned at runtime by the authenticated API.
# Must belong to the same account and mode as STRIPE_SECRET_KEY.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A random 32-byte key encoded as base64; keep it stable and backed up securely.
MEMBER_DATA_KEY=
# Select gmail to send automatically from the club account. Default: resend.
MEMBERSHIP_EMAIL_PROVIDER=resend
# Gmail requires 2-Step Verification and a Google App Password (not the account password).
GMAIL_USER=bengalistudentssociety@gmail.com
GMAIL_APP_PASSWORD=
# Existing Resend configuration is used only when the provider is resend.
RESEND_API_KEY=
MEMBERSHIP_EMAIL_FROM=
# Enable each wallet separately after issuer approval and real-device tests.
# Paid memberships and the website card do not require Apple or Google accounts.
GOOGLE_WALLET_ENABLED=false
APPLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERTIFICATE=
APPLE_PASS_PRIVATE_KEY=
APPLE_WWDR_CERTIFICATE=
# OpenSSL must be available on the deployment runtime; test before enabling Apple issuance.
OPENSSL_PATH=openssl

# Private test signup only, at /membership/test. Use a random 32+ character secret.
# Works only with sk_test_ or rk_test_ keys; keep MEMBERSHIP_ENABLED=false during testing.
MEMBERSHIP_TEST_TOKEN=
MEMBERSHIP_TEST_EMAIL=
